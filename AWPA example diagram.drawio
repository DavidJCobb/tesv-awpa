        <mxCell id="PuXn6zqc-xqxDhx_wsCg-65" edge="1" parent="1" source="PuXn6zqc-xqxDhx_wsCg-63" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="PuXn6zqc-xqxDhx_wsCg-54">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="PuXn6zqc-xqxDhx_wsCg-66" edge="1" parent="1" source="PuXn6zqc-xqxDhx_wsCg-64" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="PuXn6zqc-xqxDhx_wsCg-58">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="PuXn6zqc-xqxDhx_wsCg-69" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;autosize=1;resizable=0;textDirection=ltr;" value="These two topics are user-defined &quot;top-level groups.&quot;&lt;br&gt;We want the ability to divide potential responses&amp;nbsp;&lt;br&gt;up this way so that the game doesn&#39;t have to check&amp;nbsp;&lt;br&gt;conditions on (as many) hundreds of infos. For&amp;nbsp;&lt;br&gt;example, we may gate all &quot;exterior&quot; lines behind a&amp;nbsp;&lt;br&gt;single invisible-continue info that checks the parent&amp;nbsp;&lt;br&gt;worldspace of the actor the player is asking about,&lt;br&gt;so that all of those lines can be immediately skipped&lt;br&gt;if that actor is in an interior." vertex="1">
          <mxGeometry height="140" width="300" x="660" y="945" as="geometry" />
        </mxCell>
        <mxCell id="PuXn6zqc-xqxDhx_wsCg-70" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;autosize=1;resizable=0;textDirection=ltr;" value="&lt;div&gt;If we aren&#39;t redirected to a different branch&lt;br&gt;for the actor we&#39;re asking, then we end up&amp;nbsp;&lt;br&gt;at the actor-selection topics. These use&amp;nbsp;&lt;br&gt;an invisible-continue info with a Papyrus&amp;nbsp;&lt;/div&gt;&lt;div&gt;fragment to push the actor we&#39;re asking&amp;nbsp;&lt;br&gt;about into a quest alias, so that all of the&lt;br&gt;infos in the results topics can run their&lt;br&gt;conditions against just that one alias.&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="250" x="415" y="440" as="geometry" />
        </mxCell>
        <mxCell id="PuXn6zqc-xqxDhx_wsCg-71" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;autosize=1;resizable=0;textDirection=ltr;" value="Bribing the speaker routes back to the normal actor-selection process." vertex="1">
          <mxGeometry height="30" width="400" x="1140" y="255" as="geometry" />
        </mxCell>
        <mxCell id="PuXn6zqc-xqxDhx_wsCg-73" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;autosize=1;resizable=0;" value="&lt;div&gt;Any &lt;font face=&quot;Courier New&quot;&gt;begin-asking-to&lt;/font&gt; overrides on the speaker&lt;/div&gt;&lt;div&gt;will lead to alternate branches, via invisible-continue&amp;nbsp;&lt;/div&gt;&lt;div&gt;infos with the appropriate conditions.&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="300" x="355" y="130" as="geometry" />
        </mxCell>
