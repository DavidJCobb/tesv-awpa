         <!--
            Many of Riften's interiors have multiple floors, but the floors are 
            placed at consistent heights. These generic upstairs/downstairs 
            lines take advantage of that.
         -->
         <g name="common-interior-multiple-floors">
            <constant name="height-coordinate-b1f" value="-192" />
            <constant name="height-coordinate-1f" value="64" />
            <constant name="height-coordinate-2f" value="320" />
            <condition-set name="riften-common-interior">
               <or>
                  <parent-cell is="RiftenBeeandBarb" />
                  <parent-cell is="RiftenBlackBriarManor" />
                  <parent-cell is="RiftenBlackBriarMeadery" />
                  <parent-cell is="RiftenBlacksmith" />
                  <parent-cell is="RiftenBollisHouse" />
                  <parent-cell is="RiftenHaelgasBunkhouse" />
                  <parent-cell is="RiftenHoneyside" />
                  <parent-cell is="RiftenHouseofClanSnowShod" />
                  <parent-cell is="RiftenHouseofMjolltheLioness" />
                  <parent-cell is="RiftenPawnedPrawn" />
               </or>
            </condition-set>
            
            <g name="upstairs">
               <conditions>
                  <parent-cell of="player" same-as="subject" />
                  <!-- subject not on lowest floor; player not on highest floor -->
                  <z of="subject" gte="height-coordinate-1f" />
                  <z of="player"  lt="height-coordinate-2f" />
                  <or>
                     <!-- player on lowest floor or subject on highest floor -->
                     <!-- if we had more than 3 floors, the logic here would be more complex -->
                     <z of="subject" gte="height-coordinate-2f" />
                     <z of="player"  lt="height-coordinate-1f" />
                  </or>
                  <condition-set of="subject" name="riften-common-interior" />
               </conditions>
               <shared-infos name="shared-upstairs" />
            </g>
            <g name="downstairs">
               <conditions>
                  <!--
                     downstairs is opposite of upstairs; just switch around who we run each 
                     coordinate check on
                  -->
                  <parent-cell of="player" same-as="subject" />
                  <z of="player" gte="height-coordinate-1f" />
                  <z of="subject"  lt="height-coordinate-2f" />
                  <or>
                     <z of="player" gte="height-coordinate-2f" />
                     <z of="subject"  lt="height-coordinate-1f" />
                  </or>
                  <condition-set of="subject" name="riften-common-interior" />
               </conditions>
               <shared-infos name="shared-downstairs" />
            </g>
            <g name="same-floor">
               <conditions>
                  <parent-cell of="player" same-as="subject" />
                  <or>
                     <z of="subject" lt="height-coordinate-1f" />
                     <z of="subject" lt="height-coordinate-2f" />
                     <z of="player" gte="height-coordinate-2f" />
                  </or>
                  <or>
