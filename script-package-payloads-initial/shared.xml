      <macro name="mixin-co-owned-house-ext">
         <!--
            For a co-owned house (i.e. "Alice and Bob's house," rather than 
            "Alice's house" that Bob also lives at), handles asking a non-
            resident about another non-resident, provided at least one of 
            the residents is alive.
            
            The "notes" are spliced into specific lines used when only one 
            owner is alive. You can use them for sentence fragments that 
            characterize the surviving owner, e.g. ", the local alchemist".
         -->
         <parameter name="OWNER-1" />
         <parameter name="OWNER-2" />
         <parameter name="OWNER-1-NOTE" default-value="" />
         <parameter name="OWNER-2-NOTE" default-value="" />
         <parameter name="BOTH-DEAD-ADDITIONAL-LINES" default-value="" />
         <data>
            <g name="both-homeowners-alive">
               <conditions>
                  <death-count for="%OWNER-1%" lte="0" />
                  <death-count for="%OWNER-2%" lte="0" />
               </conditions>
               <line>He might've been headed to %OWNER-1% and %OWNER-2%'s house.</line>
               <line>I think I saw him over by %OWNER-1% and %OWNER-2%'s home.</line>
            </g>
            <g name="owner-1-dead">
               <conditions>
                  <death-count for="%OWNER-1%" gt="0" />
                  <death-count for="%OWNER-2%" lte="0" />
               </conditions>
               <line>He might've been headed to %OWNER-2%'s house.</line>
               <line>I think I saw him over by %OWNER-2%'s home.%OWNER-2-NOTE%</line>
            </g>
            <g name="owner-2-dead">
               <conditions>
                  <death-count for="%OWNER-1%" lte="0" />
                  <death-count for="%OWNER-2%" gt="0" />
               </conditions>
               <line>He might've been headed to %OWNER-1%'s house.</line>
               <line>I think I saw him over by %OWNER-1%'s home.%OWNER-1-NOTE%</line>
            </g>
            <!-- else both actors are dead -->
            <line>He's over by the house %OWNER-1% and %OWNER-2% used to live in.</line>
            %BOTH-DEAD-ADDITIONAL-LINES%
         </data>
      </macro>
      <macro name="mixin-co-owned-house-int">
         <!--
            For a co-owned house (i.e. "Alice and Bob's house," rather than 
            "Alice's house" that Bob also lives at), handles asking a non-
            resident about another non-resident, provided at least one of 
            the residents is alive.
            
            The house "note" is spliced into specific lines. You can use it 
            as a sentence fragment to describe the location of the house, 
            e.g. ", over by the lumber mill".
         -->
         <parameter name="OWNER-1" />
         <parameter name="OWNER-2" />
         <parameter name="HOUSE-LOCATION-NOTE-1" default-value="" />
         <parameter name="BOTH-DEAD-ADDITIONAL-LINES" default-value="" />
         <data>
            <g name="both-homeowners-alive">
               <conditions>
                  <death-count for="%OWNER-1%" lte="0" />
                  <death-count for="%OWNER-2%" lte="0" />
               </conditions>
               <line>He's visiting %OWNER-1% and %OWNER-2% right now.</line>
               <line>He's at %OWNER-1% and %OWNER-2%'s house%HOUSE-LOCATION-NOTE-1%.</line>
            </g>
            <g name="owner-1-dead">
               <conditions>
                  <death-count for="%OWNER-1%" gt="0" />
                  <death-count for="%OWNER-2%" lte="0" />
               </conditions>
               <line>He's visiting %OWNER-2% right now.</line>
               <line>He's at %OWNER-2%'s house%HOUSE-LOCATION-NOTE-1%.</line>
            </g>
            <g name="owner-2-dead">
               <conditions>
                  <death-count for="%OWNER-1%" lte="0" />
                  <death-count for="%OWNER-2%" gt="0" />
               </conditions>
               <line>He's visiting %OWNER-1% right now.</line>
               <line>He's at %OWNER-1%'s house%HOUSE-LOCATION-NOTE-1%.</line>
            </g>
            <!-- else both actors are dead -->
            <line>He's at the house %OWNER-1% and %OWNER-2% used to live in.</line>
            %BOTH-DEAD-ADDITIONAL-LINES%
         </data>
      </macro>
      
