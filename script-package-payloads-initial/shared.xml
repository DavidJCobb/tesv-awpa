      <macro name="mixin-interior-1f-2f">
         <!--
            Handles "upstairs" and "downstairs" lines for a building 
            with two above-ground floors.
            
            You must define the following constant in an enclosing 
            group:
            
               height-coordinate-2f
         -->
         <data>
            <g name="upstairs">
               <conditions>
                  <z of="subject" gte="height-coordinate-2f" />
                  <z of="player"  lt="height-coordinate-2f" />
               </conditions>
               <shared-info id="shared-upstairs" />
            </g>
            <g name="downstairs">
               <conditions>
                  <z of="subject" lt="height-coordinate-2f" />
                  <z of="player"  gte="height-coordinate-2f" />
               </conditions>
               <shared-info id="shared-downstairs" />
            </g>
         </data>
      </macro>
