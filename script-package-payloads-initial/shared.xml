      <macro name="common-interior-different-floors-b1f-1f-2f">
         <!--
            For a building with a basement and two above-ground floors, 
            handles "upstairs" and "downstairs" lines. You must define 
            the following constants in an enclosing group:
            
               height-coordinate-1f
               height-coordinate-2f
               
            It is assumed that you've already checked whether the player 
            and subject are in the same cell, and whether that cell has 
            a B1F, 1F, and 2F.
         -->
         <parameter name="ADDITIONAL-CONDITIONS" default-value="" />
         <data>
            <g name="upstairs">
               <conditions>
                  <!-- subject not on lowest floor; player not on highest floor -->
                  <z of="subject" gte="height-coordinate-1f" />
                  <z of="player"  lt="height-coordinate-2f" />
                  <or>
                     <!-- player on lowest floor or subject on highest floor -->
                     <!-- if we had more than 3 floors, the logic here would be more complex -->
                     <z of="subject" gte="height-coordinate-2f" />
                     <z of="player"  lt="height-coordinate-1f" />
                  </or>
                  %ADDITIONAL-CONDITIONS%
               </conditions>
               <shared-info id="shared-upstairs" />
