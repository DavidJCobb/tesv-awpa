      <!--
         Condition macros to check whether an actor is inside or outside 
         of the city walls, based on their coordinates (so, if they're in 
         an exterior cell).
      
         In practice, the only cells that are tagged with MarkarthLocation 
         outside of the city itself are in front of the main gate, so we 
         really just have to check what side of the main gate an actor is 
         on. We can represent the gate as a zig-zagged line.
      -->
      <macro name="condition-entity-outside-city-walls-ext">
         <parameter name="OF" />
         <data>
            <x of="%OF%" gte="-173280" />
            <or>
               <y of="%OF%" lte="5856" />
               <x of="%OF%" gte="-172656" />
            </or>
            <or>
               <y of="%OF%" lte="5040" />
               <x of="%OF%" gte="-172288" />
            </or>
            <or>
               <y of="%OF%" lte="3808" />
               <x of="%OF%" gte="-171728" />
            </or>
         </data>
      </macro>
      <macro name="condition-entity-inside-city-walls-ext">
         <parameter name="OF" />
         <data>
            <x of="%OF%" lt="-171728" />
            <or>
               <y of="%OF%" gt="3808" />
               <x of="%OF%" lt="-172288" />
            </or>
            <or>
               <y of="%OF%" gt="5040" />
               <x of="%OF%" lt="-172656" />
            </or>
            <or>
               <y of="%OF%" gt="5856" />
               <x of="%OF%" lt="-173280" />
            </or>
         </data>
      </macro>
      
