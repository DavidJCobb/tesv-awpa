            <g name="upstairs">
               <conditions>
                  <z of="subject" gte="height-coordinate-2f" />
                  <z of="player" lt="height-coordinate-2f" />
               </conditions>
               <shared-info id="shared-upstairs" form-ids="0100060F,01000610,01000611,01000612" />
            </g>
            <g name="downstairs">
