      <!--<invoke name="common-super-near-player" />-->
            <top-g slug="SuperNearPlayer">
               <conditions>
                  <distance to="subject" of="player" lte="256" />
               </conditions>
               <shared-info id="shared-near-player" form-ids="0100060B,0100060C,0100060D,0100060E" />
            </top-g>
         <!-- macro substitution end -->
      <top-g slug="SameInterior">
         <conditions>
            <is-in-interior of="subject" />
            <parent-cell of="speaker" same-as="subject" />
         </conditions>
         
         <g name="different-floors">
            <g name="thaumaturgist">
