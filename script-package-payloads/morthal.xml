<?xml version="1.0" encoding="utf-8"?>
<payload>
   <quest id="AWPAMorthal"
      locations="MorthalLocation"
   >
      <dialogue-conditions>
         <faction-membership of="speaker" includes="TownMorthalFaction" />
         <faction-membership of="speaker" excludes="GuardFactionMorthal" />
         
         <location of="speaker" is="MorthalLocation" />
      </dialogue-conditions>
      <actors>
         <actor editor-id="Agni" />
         <actor editor-id="Alva">
            <begin-asking-about>
               <filter-conditions>
                  <!--
                     Don't allow asking about Alva once she's outed as a vampire.
                  -->
                  <quest-not-completed name="MS14" />
                  <papyrus-quest-variable
                     for="MS14"
                     var="::PCFoundAlvasCoffin_var"
                     eq="0"
                  />
               </filter-conditions>
            </begin-asking-about>
         </actor>
         <actor editor-id="Aslfur" />
         <actor editor-id="Benor" />
         <actor editor-id="Falion" />
         <actor editor-id="Gorm" />
         <actor editor-id="Hroggar" />
         <actor editor-id="IdgrodRavencrone" name="Idgrod Ravencrone" />
         <actor editor-id="IdgrodTheYounger" name="Idgrod the Younger" />
         <actor editor-id="Jonna" />
         <actor editor-id="Jorgen" />
         <actor editor-id="Joric" />
         <actor editor-id="Lami" />
         <actor editor-id="Thonnir" />
         <actor editor-id="Virkmund" />
      </actors>
      
      <invoke name="common-super-near-player" />
      <top-g slug="SameInterior">
         <conditions>
            <is-in-interior of="subject" />
            <parent-cell of="speaker" same-as="subject" />
         </conditions>
         
         <g name="different-floors">
            <g name="thaumaturgist">
               <conditions>
                  <parent-cell of="subject" is="MorthalThaumaturgistsHut" />
               </conditions>
               <constant name="height-coordinate-2f" value="240" />
               <invoke name="mixin-interior-1f-2f-no-rooms" />
            </g>
         </g>
         
         <!--
            TODO: per-room checks for Highmoon Hall and Moorside Inn
         -->
         
         <shared-info id="shared-same-building" />
      </top-g>
      <top-g slug="Interiors">
         <conditions>
            <is-in-interior of="subject" />
         </conditions>
         
         <g name="guardhouse-or-jail">
            <conditions>
               <or>
                  <parent-cell of="subject" is="MorthalGuardhouse" />
                  <parent-cell of="subject" is="MorthalGuardhouseJail" />
               </or>
            </conditions>
            <line>I think he's stopping by the Guardhouse.</line>
            <line>Check the Guardhouse. I saw him walk in there earlier.</line>
            <line>He might be in the Guardhouse right now.</line>
         </g>
         <g name="guardhouse-to-jail">
            <conditions>
               <parent-cell of="subject" is="MorthalGuardhouseJail" />
               <parent-cell of="speaker" is="MorthalGuardhouse" />
            </conditions>
            <line>He's downstairs.</line>
            <line>Head down the stairs, to the town jail. You'll find him in there.</line>
         </g>
         <g name="guardhouse-per-jail">
            <conditions>
               <parent-cell of="subject" is="MorthalGuardhouse" />
               <parent-cell of="speaker" is="MorthalGuardhouseJail" />
            </conditions>
            <line>He's upstairs.</line>
         </g>
         <g name="highmoon-hall">
            <conditions>
               <parent-cell of="subject" is="MorthalHighmoonHall" />
            </conditions>
            <line>I believe he's visiting Highmoon Hall right now.</line>
            <line>Pretty sure he's at the town hall.</line>
            <line>Highmoon Hall would be a good place to check, if you haven't already.</line>
         </g>
         <g name="house-alva">
            <conditions>
               <or>
                  <parent-cell of="subject" is="MorthalAlvasHouse" />
                  <parent-cell of="subject" is="MorthalAlvasHouseCellar" />
               </or>
            </conditions>
            <g name="subject-downstairs-speaker-upstairs">
               <conditions>
                  <parent-cell of="subject" is="MorthalAlvasHouseCellar" />
                  <parent-cell of="speaker" is="MorthalAlvasHouse" />
               </conditions>
               <shared-info id="shared-downstairs" />
            </g>
            <g name="subject-upstairs-speaker-downstairs">
               <conditions>
                  <parent-cell of="subject" is="MorthalAlvasHouse" />
                  <parent-cell of="speaker" is="MorthalAlvasHouseCellar" />
               </conditions>
               <shared-info id="shared-upstairs" />
            </g>
            <g name="asking-alva">
               <conditions>
                  <actor-base of="speaker" is="Alva" />
               </conditions>
               <shared-info id="shared-at-my-home" />
               <!--
                  It is intentional that I don't define lines for asking Alva 
                  about Hroggar's location, when Hroggar is at her home. I like 
                  the subtle nuance of her replying with "He's at *my* house" 
                  (emphasis mine) rather than "He's at *our* house."
               -->
            </g>
            <g name="asking-about-alva">
               <conditions>
                  <actor-base of="subject" is="Alva" />
               </conditions>
               <g name="asking-hroggar-about-alva">
                  <conditions>
                     <actor-base of="speaker" is="Hroggar" />
                  </conditions>
                  <shared-info id="shared-at-our-home" />
                  <!--
                     I've gone out of my way to make Hroggar use the "She's at 
                     *our* house" lines as part of the same nuance: their 
                     relationship is asymmetrical; she's using him.
                  -->
               </g>
               <shared-info id="shared-at-own-home" />
            </g>
            <g name="asking-about-hroggar">
               <conditions>
                  <actor-base of="subject" is="Hroggar" />
               </conditions>
               <g name="alva-slain">
                  <conditions>
                     <death-count of="Alva" gt="0" />
                  </conditions>
                  <shared-info id="shared-at-own-home" />
               </g>
               <line><verbatim>He's</verbatim> at Alva's house. <verbatim>He's</verbatim> been staying there since <verbatim>his</verbatim> place got destroyed by a fire.</line>
               <line><verbatim>He's</verbatim> been living with Alva ever since <verbatim>his</verbatim> home burned down.</line>
            </g>
            <g name="alva-slain">
               <conditions>
                  <death-count of="Alva" gt="0" />
               </conditions>
               <line>I think he's at Hroggar's home right now. The place used to belong to Alva, but...</line>
               <line>Pretty sure I saw him walk into Hroggar's house recently.</line>
               <line>He's visiting Hroggar's new house, at the southeast edge of town.</line>
            </g>
            <line>I think he's at Alva's home right now.</line>
            <line>Pretty sure I saw him walk into Alva's house recently.</line>
            <line>He's visiting Alva's house.</line>
         </g>
         <g name="house-falion">
            <conditions>
               <parent-cell of="subject" is="MorthalFalionsHouse" />
            </conditions>
            <invoke name="mixin-house-two-residents-int">
               <parameter name="OWNER-1" value="Falion" />
               <parameter name="OWNER-2" value="Agni" />
            </invoke>
            <line>He was headed to Falion's house earlier.</line>
            <line>I saw him walk into Falion's house a while ago.</line>
            <line>I think he was at Falion's house.</line>
         </g>
         <g name="house-jorgen-lami">
            <conditions>
               <parent-cell of="subject" is="MorthalJorgenandLamisHouse" />
            </conditions>
            <invoke name="mixin-house-two-residents-int">
               <parameter name="OWNER-1" value="Jorgen" />
               <parameter name="OWNER-2" value="Lami" />
            </invoke>
            <invoke name="mixin-co-owned-house-int">
               <parameter name="OWNER-1" value="Jorgen" />
               <parameter name="OWNER-2" value="Lami" />
               <parameter name="HOUSE-LOCATION-NOTE-1" value=", on the north edge of town" />
               <parameter name="BOTH-DEAD-ADDITIONAL-LINES">
                  <line>He's at the abandoned house on the north edge of town.</line>
               </parameter>
            </invoke>
         </g>
         <g name="house-thonnir">
            <conditions>
               <parent-cell of="subject" is="MorthalThonnirsHouse" />
            </conditions>
            <invoke name="mixin-house-two-residents-int">
               <parameter name="OWNER-1" value="Thonnir" />
               <parameter name="OWNER-2" value="Vikmund" />
            </invoke>
            <line>I saw him on his way to Thonnir's house.</line>
            <line>I'm pretty sure he's stopping by Thonnir's house right now.</line>
         </g>
         <g name="moorside-inn">
            <conditions>
               <parent-cell of="subject" is="MorthalMoorsideInn" />
            </conditions>
            <line>He's at Moorside Inn right now.</line>
            <line>He's over at the local inn.</line>
         </g>
         <g name="thaumaturgist">
            <conditions>
               <parent-cell of="subject" is="MorthalThaumaturgistsHut" />
            </conditions>
            <g>
               <conditions>
                  <actor-base of="subject" is="Lami" />
               </conditions>
               <line>The alchemist? He's at work right now, at the Thaumaturgist's Hut.</line>
               <line>He's tending to his potion shop in the middle of town.</line>
            </g>
            <line>He's at the Thaumaturgist's Hut.</line>
            <line>He's visiting the local alchemist right now.</line>
            <line>Check the Thaumaturgist's Hut. Two-story building at the center of town.</line>
         </g>
         
         <invoke name="common-me-outside-they-inside" />
      </top-g>
      <top-g slug="Exterior">
         <conditions>
            <parent-world of="subject" is="Tamriel" />
         </conditions>
         
         <g name="bridge">  
            <conditions>
               <x of="subject" gte="-39808" />
               <x of="subject" lte="-39088" />
               <y of="subject" gte="67488" />
               <y of="subject" lte="69680" />
               <z of="subject" gte="-13808" />
            </conditions>
            <line>I saw him on the city's north bridge not too long ago.</line>
            <line>Check the bridge leading north out of Morthal.</line>
            <line>I'm pretty sure he's over on the bridge.</line>
         </g>
         
         <g name="burned-house">  
            <conditions>
               <x of="subject" gte="-42192" />
               <x of="subject" lte="-39680" />
               <y of="subject" gte="63120" />
               <y of="subject" lte="64688" />
            </conditions>
            <line>I think he was headed in the direction of Hroggar's old house. It burned down not too long ago.</line>
            <line>I saw him headed toward the burned house next to the inn, where Hroggar used to live.</line>
            <line>He was walking around the burned-down house to the west not too long ago.</line>
         </g>
         <g name="house-alva">
            <conditions>
               <x of="subject" gte="-35952" />
               <x of="subject" lte="-34096" />
               <y of="subject" gte="63056" />
               <y of="subject" lte="65040" />
            </conditions>
            <!--
               See comments on the "interior" version of these checks for design 
               notes.
            -->
            <g name="asking-alva">
               <conditions>
                  <actor-base of="speaker" is="Alva" />
               </conditions>
               <shared-info id="shared-exterior-near-my-home" />
            </g>
            <g name="asking-hroggar">
               <conditions>
                  <actor-base of="speaker" is="Hroggar" />
               </conditions>
               <g name="asking-about-alva">
                  <conditions>
                     <actor-base of="subject" is="Alva" />
                  </conditions>
                  <shared-info id="shared-exterior-near-our-home" />
               </g>
               <shared-info id="shared-exterior-near-my-home" />
            </g>
            <g name="asking-about-alva">
               <conditions>
                  <actor-base of="subject" is="Alva" />
               </conditions>
               <shared-info id="shared-exterior-near-own-home" />
            </g>
            <g name="asking-about-hroggar">
               <conditions>
                  <actor-base of="subject" is="Hroggar" />
               </conditions>
               <g name="alva-slain">
                  <conditions>
                     <death-count of="Alva" gt="0" />
                  </conditions>
                  <shared-info id="shared-exterior-near-own-home" />
               </g>
               <line><verbatim>He's</verbatim> over by Alva's house. <verbatim>He's</verbatim> been staying there since <verbatim>his</verbatim> place got destroyed by a fire.</line>
               <line><verbatim>He's</verbatim> been living with Alva ever since <verbatim>his</verbatim> home burned down.</line>
            </g>
            <g name="alva-slain">
               <conditions>
                  <death-count of="Alva" gt="0" />
               </conditions>
               <line>I think he's somewhere near Hroggar's house. The place used to belong to Alva, but...</line>
               <line>Pretty sure I saw him around Hroggar's new home recently.</line>
               <line>Try looking around Hroggar's new house, at the southeast edge of town.</line>
            </g>
            <line>I think he's somewhere near Alva's home right now.</line>
            <line>Pretty sure I saw him around Alva's house recently.</line>
            <line>Try looking around Alva's house.</line>
         </g>
         <g name="house-falion">
            <conditions>
               <x of="subject" gte="-36384" />
               <x of="subject" lte="-34096" />
               <y of="subject" gte="65040" />
               <y of="subject" lte="68672" />
            </conditions>
            <invoke name="mixin-house-two-residents-ext">
               <parameter name="OWNER-1" value="Falion" />
               <parameter name="OWNER-2" value="Agni" />
            </invoke>
            <line>He passed by Falion's house a little while ago.</line>
            <line>I spotted him over around Falion's home earlier. He might still be there.</line>
            <line>I saw him near Falion's house, on the east edge of town.</line>
         </g>
         <g name="house-jorgen-lami">  
            <conditions>
               <x of="subject" gte="-41712" />
               <x of="subject" lte="-39232" />
               <y of="subject" gte="69328" />
               <y of="subject" lte="71568" />
            </conditions>
            <invoke name="mixin-house-two-residents-ext">
               <parameter name="OWNER-1" value="Jorgen" />
               <parameter name="OWNER-2" value="Lami" />
            </invoke>
            <invoke name="mixin-co-owned-house-ext">
               <parameter name="OWNER-1" value="Jorgen" />
               <parameter name="OWNER-2" value="Lami" />
               <parameter name="OWNER-1-NOTE"> <verbatim>He</verbatim> runs the lumber mill right next to it.</parameter>
               <parameter name="OWNER-2-NOTE"> <verbatim>She</verbatim> runs the alchemy shop at the center of town, but <verbatim>she</verbatim> lives over by the lumber mill.</parameter>
               <parameter name="BOTH-DEAD-ADDITIONAL-LINES">
                  <line>He's over by the house across the bridge.</line>
                  <line>I think I saw him headed toward the abandoned house by the lumber mill.</line>
               </parameter>
            </invoke>
         </g>
         <g name="house-thonnir">
            <conditions>
               <x of="subject" gte="-38912" />
               <x of="subject" lte="-36384" />
               <y of="subject" gte="65648" />
               <y of="subject" lte="67056" />
            </conditions>
            <invoke name="mixin-house-two-residents-ext">
               <parameter name="OWNER-1" value="Thonnir" />
               <parameter name="OWNER-2" value="Virkmund" />
            </invoke>
            <line>He was hanging around Thonnir's house a little while ago.</line>
            <line>I saw him by Thonnir's house recently.</line>
            <line>I'm fairly sure he's near Thonnir's house right now.</line>
         </g>
         <g name="lumber-mill">  
            <conditions>
               <x of="subject" gte="-39232" />
               <x of="subject" lte="-36192" />
               <y of="subject" gte="69328" />
               <y of="subject" lte="71568" />
            </conditions>
            <shared-info id="shared-exterior-lumber-mill" />
         </g>
         <g name="moorside-inn">  
            <conditions>
               <x of="subject" gte="-41184" />
               <x of="subject" lte="-39424" />
               <y of="subject" gte="64688" />
               <y of="subject" lte="67152" />
            </conditions>
            <line>I think he's over by the Moorside Inn.</line>
            <line>Have you looked around the local inn?</line>
            <line>I saw him headed toward the Moorside Inn not too long ago.</line>
         </g>
         <g name="thaumaturgist">  
            <conditions>
               <x of="subject" gte="-38848" />
               <x of="subject" lte="-37104" />
               <y of="subject" gte="64288" />
               <y of="subject" lte="65648" />
            </conditions>
            <line>He was headed by the alchemist's shop. It's near the center of town.</line>
            <line>I think he might've been on his way to the Thaumaturgist's Hut?</line>
         </g>
         
         <g name="guardhouse">  
            <conditions>
               <x of="subject" gte="-37568" />
               <x of="subject" lte="-35440" />
               <y of="subject" gte="62016" />
               <y of="subject" lte="64144" />
            </conditions>
            <line>I saw him hanging around the Guardhouse, near Morthal's south entrance.</line>
            <line>I'm pretty sure he's by the Guardhouse.</line>
            <line>I'd try checking the Guardhouse.</line>
         </g>
         <g name="highmoon-hall">  
            <conditions>
               <x of="subject" gte="-39856" />
               <x of="subject" lte="-37872" />
               <y of="subject" gte="62704" />
               <y of="subject" lte="64688" />
            </conditions>
            <line>I saw him around Highmoon Hall not too long ago.</line>
            <line>Have you looked near the town hall?</line>
         </g>
         
         <g name="low-detail">
            <g name="main-street">  
               <conditions>
                  <x of="subject" gte="-40000" />
                  <x of="subject" lte="-38848" />
                  <y of="subject" gte="64688" />
                  <y of="subject" lte="67488" />
               </conditions>
               <line>He's out on the main street running through town.</line>
               <line>He's on Morthal's main road, between the town hall and the inn.</line>
            </g>
            <g name="west-trail">  
               <conditions>
                  <x of="subject" gte="-45056" />
                  <x of="subject" lte="-41184" />
                  <y of="subject" gte="63728" />
                  <y of="subject" lte="68608" />
               </conditions>
               <line>I think he was headed toward one of the trails to the west.</line>
               <line>There's a hiking trail to the west that people occasionally follow. I saw him headed that way.</line>
            </g>
            <g name="river">  
               <conditions>
                  <x of="subject" gte="-43312" />
                  <x of="subject" lte="-35312" />
                  <y of="subject" gte="67056" />
                  <y of="subject" lte="69328" />
               </conditions>
               <line>He's out on the river that runs through town -- the one with a bridge across it.</line>
            </g>
            <g name="southeast-walkways">  
               <conditions>
                  <x of="subject" gte="-37872" />
                  <x of="subject" lte="-35952" />
                  <y of="subject" gte="63536" />
                  <y of="subject" lte="65648" />
               </conditions>
               <line>I saw him out on the walkways, in the southeast part of town.</line>
               <line>I'm pretty sure he's on the walkways and piers on the eastern half of town... or maybe in the water.</line>
            </g>
            <g name="south-entrance">  
               <conditions>
                  <x of="subject" gte="-38816" />
                  <x of="subject" lte="-35808" />
                  <y of="subject" gte="61440" />
                  <y of="subject" lte="63536" />
               </conditions>
               <line>He's over by the southern road into town.</line>
               <line>Check by the south road out of Morthal.</line>
               <line>I'm pretty sure he's around the town's main entrance, south of Highmoon Hall.</line>
            </g>
         </g>
         <g name="directional-fallbacks">
            <g name="north">  
               <conditions>
                  <x of="subject" gte="-45056" />
                  <x of="subject" lte="-32768" />
                  <y of="subject" gte="69328" />
                  <y of="subject" lte="77824" />
               </conditions>
               <shared-info id="beyond-city-limits-north" />
            </g>
            <g name="east">  
               <conditions>
                  <x of="subject" gte="-35312" />
                  <x of="subject" lte="-28672" />
                  <y of="subject" gte="57344" />
                  <y of="subject" lte="77824" />
               </conditions>
               <shared-info id="beyond-city-limits-east" />
            </g>
            <g name="west">  
               <conditions>
                  <x of="subject" gte="-53248" />
                  <x of="subject" lte="-38816" />
                  <y of="subject" gte="57344" />
                  <y of="subject" lte="77824" />
               </conditions>
               <shared-info id="beyond-city-limits-west" />
            </g>
            <g name="south">  
               <conditions>
                  <x of="subject" gte="-38816" />
                  <x of="subject" lte="-35312" />
                  <y of="subject" gte="57344" />
                  <y of="subject" lte="63056" />
               </conditions>
               <shared-info id="beyond-city-limits-south" />
            </g>
         </g>

         <invoke name="common-exterior-fallbacks" />
      </top-g>
      
      <!-- final fallback lines -->
      <shared-info id="shared-unknown" />
   </quest>
</payload>