<?xml version="1.0" encoding="utf-8"?>
<payload>
   <shared-infos>
      <shared-info id="shared-upstairs" editor-id-slug="FloorUpstairs">
         <line>He's upstairs.</line>
         <line>Try checking upstairs.</line>
         <line>Try looking upstairs.</line>
      </shared-info>
   </shared-infos>
   <quest id="AWPATestQuest01">
      <dialogue-conditions>
         <faction-membership of="speaker" includes="TownRiftenFaction" />
         <faction-membership of="speaker" excludes="GuardFactionRiften" />
      </dialogue-conditions>
   
      <condition-set name="subject-upstairs-from-player">
         <z of="subject" gte="64" />
         <z of="player"  lt="320" />
         <or>
            <!-- player on lowest floor or subject on highest floor -->
            <!-- if we had more than 3 floors, the logic here would be more complex -->
            <z of="subject" gte="320" />
            <z of="player"  lt="64" />
         </or>
      </condition-set>
      
      <macro name="test-macro">
         <parameter name="ACTOR" />
         <parameter name="ACTOR_NAME" default-value="%ACTOR%" />
         <data>
            <conditions>
               <actor-base is="%ACTOR%" />
            </conditions>
            <line>Oh, you mean %ACTOR_NAME%?</line>
         </data>
      </macro>
   
      <actors>
         <actor editor-id="Grelka">
            <begin-asking-to>
               <topic>
                  <g non-exclusive="true">
                     <conditions>
                        <offers-services of="speaker" />
                     </conditions>
                     <line emotion="disgust:80">I sell weapons and armor, not directions.</line>
                     <line emotion="disgust:90">No. Buy something or move on.</line>
                  </g>
                  <line emotion="disgust:90">I'm not your tour guide. Find somebody else to bother about it.</line>
                  <line emotion="disgust:80">No. I'm too busy running my shop to keep track of everyone else.</line>
                  <line emotion="disgust:100">Whoever it is, I'm not their keeper, I don't know where they're at, and I don't care.</line>
               </topic>
            </begin-asking-to>
         </actor>
         <actor editor-id="Ingun">
            <begin-responding>
               <topic>
                  <!--
                     Ingun should seem distracted and fail to provied a useful 
                     answer unless you've done her favor quest.
                  -->
                  <conditions>
                     <quest-not-completed name="[QUST:00053308]FreeformRiften04" />
                     <!-- She is attentive to her family members: -->
                     <actor-base of="subject" is-not="Hemming" />
                     <actor-base of="subject" is-not="Maven" />
                     <actor-base of="subject" is-not="Sibbi" />
                     <!-- ...And to the town alchemists: -->
                     <actor-base of="subject" is-not="Hafjorg" />
                     <actor-base of="subject" is-not="Elgrim" />
                  </conditions>
                  <g non-exclusive="true">
                     <conditions>
                        <global name="GameHour" gte="12" />
                        <global name="GameHour" lt="18" />
                     </conditions>
                     <line emotion="puzzled:60">I'm afraid I don't know. I've been planning new alchemical experiments all day.</line>
                  </g>
                  <g non-exclusive="true">
                     <conditions>
                        <global name="GameHour" gte="18" />
                        <global name="GameHour" lte="23" />
                     </conditions>
                     <line emotion="puzzled:80">I'm afraid I don't know. I've been planning new alchemical experiments all night.</line>
                  </g>
                  <line>I haven't noticed him around town. You'll have to ask someone else.</line>
                  <line emotion="puzzled:90">Hmm... I don't remember seeing him, but... I probably wouldn't have noticed him.</line>
                  <line>I've been too focused on my experiments to really notice him.</line>
                  <line hours-until-reset="24" emotion="puzzled:70">I'm not sure. I've been thinking about my experiments... Would you happen to know a good place to gather Painted Troll Fat? Sorry, never mind.</line>
               </topic>
            </begin-responding>
         </actor>
         <actor editor-id="Maul">
            <begin-asking-to>
               <!--
                  If you're not in the Thieves Guild and have never intimidated 
                  Maul, then you'll need to bribe him.
               -->
               <bribe>
                  <conditions>
                     <!--<condition-set name="player-not-in-thieves-guild" />-->
                     <or>
                        <!-- never bribed or intimidated Maul: -->
                        <quest-stage for="[QUST:000649FC]DialogueRiftenMaul" not-done="30" />
                        <!-- tried and failed to intimidate Maul: -->
                        <quest-stage for="[QUST:000649FC]DialogueRiftenMaul" done="35" />
                     </or>
                  </conditions>
                  <begin-lines>
                     <line>If you want dirt, it'll cost you.</line>
                     <line script-notes="Emphasis on the word &quot;might&quot;.">If you've got gold, I might have information.</line>
                  </begin-lines>
                  <accept-lines>
                     <line>All right. Who are you looking for?</line>
                     <line>Good. So who are you trying to find?</line>
                     <line>Okay, let's talk. Who are you looking for?</line>
                     <line vanilla="[INFO:0006D4A8]/#2">So what do you want to know?</line>
                  </accept-lines>
                  <refuse-lines>
                     <line>Fine by me.</line>
                     <line>Then quit wastin' my time.</line>
                     <g>
                        <conditions>
                           <!-- Maul is at the docks. -->
                           <quest-stage for="[QUST:000649FC]DialogueRiftenMaul" done="40" />
                           <!-- TODO: Check if he's actually physically at the docks -->
                        </conditions>
                        <line>I'll be here when you change your mind.</line>
                     </g>
                     <g>
                        <conditions>
                           <!-- Maul is not at the docks. -->
                           <quest-stage for="[QUST:000649FC]DialogueRiftenMaul" not-done="40" />
                        </conditions>
                        <line vanilla="[INFO:000649F5]/#2">I'll be at the docks if you change your mind.</line>
                     </g>
                     <line vanilla="[INFO:000649F5]/#1">Suit yourself.</line>
                  </refuse-lines>
                  <poor-lines>
                     <line>Come back when you have somethin' to bargain with.</line>
                     <line>Then you aren't worth my time.</line>
                     <line vanilla="[INFO:000649E5]">You don't have enough to earn my loyalty.</line>
                  </poor-lines>
               </bribe>
            </begin-asking-to>
         </actor>
         <actor editor-id="TalenJei" name="Talen-Jei" />
      </actors>
      <g name="upstairs">
         <conditions>
            <condition-set name="subject-upstairs-from-player" />
         </conditions>
         <shared-info id="shared-upstairs" />
      </g>
      <top-g slug="RecognizeTalenJei">
         <invoke name="test-macro">
            <parameter name="ACTOR" value="TalenJei" />
            <parameter name="ACTOR_NAME" value="Talen-Jei" />
         </invoke>
      </top-g>
      <top-g slug="RecognizeMaul">
         <invoke name="test-macro">
            <parameter name="ACTOR" value="Maul" />
         </invoke>
      </top-g>
      <g name="fallbacks">
         <line emotion="puzzled:70">I'm not sure where he is.</line>
         <line emotion="puzzled:60">I don't know where he's at.</line>
         <line>Haven't seen him around.</line>
      </g>
   </quest>
</payload>