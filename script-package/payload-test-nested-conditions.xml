<?xml version="1.0" encoding="utf-8"?>
<payload>
   <shared-infos>
      <shared-info id="shared-upstairs" editor-id-slug="FloorUpstairs">
         <line>He's upstairs.</line>
         <line>Try checking upstairs.</line>
         <line>Try looking upstairs.</line>
      </shared-info>
   </shared-infos>
   <quest id="AWPATestQuest01">
      <actors>
         <actor editor-id="TalenJei" name="Talen-Jei" />
      </actors>
      <g name="upstairs">
         <conditions>
            <z of="subject" gte="64" />
            <z of="player"  lt="320" />
            <or>
               <!-- player on lowest floor or subject on highest floor -->
               <!-- if we had more than 3 floors, the logic here would be more complex -->
               <z of="subject" gte="320" />
               <z of="player"  lt="64" />
            </or>
         </conditions>
         <g name="sky">
            <conditions>
               <!--
                  this is not ideal for "production" content, because the conditions 
                  in the outer group will be kept and be redundant with this; but for 
                  a simple test, this is fine
               -->
               <z of="subject" gte="10000" />
            </conditions>
            <g name="night" non-exclusive="true">
               <conditions>
                  <or>
                     <global name="GameHour" lte="4" />
                     <global name="GameHour" gte="20" />
                  </or>
               </conditions>
               <line>He shot for the moon and missed.</line>
            </g>
            <line>He's somewhere in the stratosphere.</line>
            <line>He's up in the sky.</line>
         </g>
         <shared-info id="shared-upstairs" />
      </g>
      <g>
         <line>Test Line 01</line>
         <line>Test Line 02</line>
      </g>
   </quest>
</payload>